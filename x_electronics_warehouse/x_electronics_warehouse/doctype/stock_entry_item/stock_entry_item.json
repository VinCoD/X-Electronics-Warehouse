{
  "doctype": "DocType",
  "name": "Stock Entry Item",
  "module": "X Electronics Warehouse",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": ["item", "qty", "basic_rate", "uom", "description"],
  "fields": [
    {"fieldname": "item", "fieldtype": "Link", "label": "Item", "options": "Item", "reqd": 1, "in_list_view": 1},
    {"fieldname": "qty", "fieldtype": "Float", "label": "Quantity", "precision": "6", "reqd": 1, "in_list_view": 1},
    {"fieldname": "basic_rate", "fieldtype": "Currency", "label": "Unit Cost", "depends_on": "eval:parent.stock_entry_type=='Receipt'", "mandatory_depends_on": "eval:parent.stock_entry_type=='Receipt'"},
    {"fieldname": "uom", "fieldtype": "Data", "label": "UOM", "fetch_from": "item.stock_uom", "read_only": 1},
    {"fieldname": "description", "fieldtype": "Data", "label": "Description", "fetch_from": "item.description", "read_only": 1}
  ],
  "permissions": []
}
