{
  "doctype": "DocType",
  "name": "Item",
  "module": "X Electronics Warehouse",
  "custom": 0,
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": ["item_code", "item_name", "description", "stock_uom", "disabled"],
  "fields": [
    {"fieldname": "item_code", "fieldtype": "Data", "label": "Item Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "item_name", "fieldtype": "Data", "label": "Item Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "stock_uom", "fieldtype": "Data", "label": "Stock UOM", "default": "Unit", "reqd": 1},
    {"fieldname": "disabled", "fieldtype": "Check", "label": "Disabled", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "email": 1}],
  "autoname": "field:item_code",
  "title_field": "item_name",
  "search_fields": "item_code,item_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
